{
  "name": "ora-transcoding-service",
  "version": "1.0.0",
  "description": "Cloud Run transcoding service for Ora media processing (Supabase backend)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc --watch & nodemon dist/index.js",
    "clean": "rm -rf dist",
    "docker:build": "npm run build && docker build -t ora-transcoding .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env ora-transcoding"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "fluent-ffmpeg": "^2.1.2"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
